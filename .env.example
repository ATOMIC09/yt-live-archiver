# yt-live-archiver environment variables
# Copy this file to .env and fill in your values.
# All settings are optional except CHANNELS.

# ── Required ──────────────────────────────────────────────────────────────────
# One or more YouTube channels to monitor.
# Format: id:Display Name:https://www.youtube.com/@handle/live
# Multiple channels: comma-separated
CHANNELS=nasa:NASA:https://www.youtube.com/@NASA/live

# ── Storage (defaults shown) ──────────────────────────────────────────────────
# Mount your NAS dataset or local path to /data (or override these paths).
# WORKING_DIR=/data/working    # Temp dir while yt-dlp is recording
# OUTPUT_DIR=/data/archive     # Final archive destination
# FAILED_DIR=/data/failed      # Failed recordings for inspection

# ── Google Drive (disabled by default) ───────────────────────────────────────
# How to get credentials (one-time setup):
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Desktop app type)
#   3. Copy the Client ID and Client Secret below
#   4. Go to https://developers.google.com/oauthplayground
#      → Settings → Use your own OAuth credentials → paste Client ID & Secret
#   5. Authorize "https://www.googleapis.com/auth/drive" scope
#   6. Exchange authorization code for tokens → copy the Refresh Token
#   7. Find your folder ID from the Drive URL: /folders/<GOOGLE_FOLDER_ID>
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_FOLDER_ID=
# GOOGLE_SHARED_DRIVE_ID=   # Workspace Shared Drives only
# GOOGLE_CHUNK_SIZE_MB=64

# ── Webhook / Discord (disabled by default) ───────────────────────────────────
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
WEBHOOK_ENABLED=false
WEBHOOK_URL=
# WEBHOOK_TIMEOUT=15
# WEBHOOK_MAX_ATTEMPTS=10

# ── Recording tuning (defaults shown) ────────────────────────────────────────
# POLL_INTERVAL=30             # Seconds between channel polls (min 5)
# LIVE_FROM_START=true         # Record from stream beginning
# WAIT_FOR_VIDEO=300           # Wait for scheduled stream to start (seconds)
# RECORDING_FORMAT=bv*[vcodec^=vp9]+ba/bv+ba/best
# RECORDING_CONTAINER=mkv
# MIN_DURATION=30              # Reject recordings shorter than this (seconds)
# REQUIRE_VIDEO=true
# REQUIRE_AUDIO=true
# DECODE_TEST=true             # ffmpeg null-decode integrity test (slower but thorough)

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO               # DEBUG / INFO / WARNING / ERROR
# TZ=UTC                       # Timezone for log timestamps
