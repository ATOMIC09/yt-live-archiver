# .env.example — Example environment variables for yt-live-archiver
#
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Config path (optional, defaults to /config/config.yaml) ─────────────────
# CONFIG_PATH=/config/config.yaml

# ── Google Drive (can also be set in config.yaml) ────────────────────────────
# Override the credentials file path if different from default
# GOOGLE_CREDENTIALS_FILE=/credentials/google-credentials.json

# Google Shared Drive ID (leave blank if uploading to a personal Drive folder)
# GOOGLE_SHARED_DRIVE_ID=

# Google Drive folder ID where recordings will be uploaded
# GOOGLE_FOLDER_ID=

# ── Webhook ───────────────────────────────────────────────────────────────────
# Webhook URL for notifications (Discord, Slack, custom endpoint)
# WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=UTC
